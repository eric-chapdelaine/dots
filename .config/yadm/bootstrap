#!/usr/bin/env bash
# yadm bootstrap — run by `yadm clone` (prompted) or `yadm bootstrap`.
# Installs what the tracked configs assume. Idempotent: safe to re-run.
set -euo pipefail

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }

OS="$(uname -s)"

# ── Shared: installed by the platform package manager ────────────────────────
pkgs_arch=(
    git zsh tmux neovim
    tree-sitter-cli        # REQUIRED: builds nvim-treesitter parsers.
                           # Without it folding/highlighting silently fail.
    ripgrep fd fzf the_silver_searcher
    nodejs npm pnpm
    github-cli
    i3-wm polybar autorandr
    lf maim
    docker
    jq                     # herdr custom keybinds pipe JSON through jq
    qemu-base              # gondolin (pig) needs qemu-img + qemu-system-x86_64
                           # even on the krun backend (qcow2 CoW rootfs)
)
pkgs_brew=(
    git zsh tmux neovim tree-sitter
    ripgrep fd fzf the-silver-searcher
    node pnpm
    gh
    universal-ctags
    mise
    jq                     # herdr custom keybinds pipe JSON through jq
    qemu                   # gondolin (pig); Apple Silicon runs arm64 guests
)

case "$OS" in
Linux)
    if command -v pacman >/dev/null 2>&1; then
        log "pacman: installing packages"
        sudo pacman -S --needed --noconfirm "${pkgs_arch[@]}"
    else
        warn "Not an Arch system — install manually: ${pkgs_arch[*]}"
    fi
    ;;
Darwin)
    if command -v brew >/dev/null 2>&1; then
        log "brew: installing packages"
        brew install "${pkgs_brew[@]}" || true
        # macOS window management lives in .config/{yabai,skhd}##os.Darwin
        brew install --cask ghostty 2>/dev/null || warn "ghostty: install manually"
        brew tap koekeishiya/formulae 2>/dev/null || true
        brew install koekeishiya/formulae/yabai koekeishiya/formulae/skhd 2>/dev/null \
            || warn "yabai/skhd: install manually (both need sudoers setup)"
    else
        warn "Homebrew missing — install it first: https://brew.sh"
        exit 1
    fi
    ;;
*)
    warn "Unsupported OS: $OS"
    exit 1
    ;;
esac

# ── Alternates ───────────────────────────────────────────────────────────────
log "materialising yadm alternates"
yadm alt || true

# ── herdr: agent-aware multiplexer ────────────────────────────────────────────
# Binary comes from the upstream installer ($HOME/.local/bin on both OSes).
# The pi integration file and zsh completion are generated, not tracked.
if ! command -v herdr >/dev/null 2>&1; then
    log "herdr: installing"
    curl -fsSL https://herdr.dev/install.sh | sh || warn "herdr: install failed, see https://herdr.dev"
fi
if command -v herdr >/dev/null 2>&1; then
    log "herdr: installing pi integration (generated file, not tracked)"
    herdr integration install pi >/dev/null 2>&1 || warn "herdr pi integration: install failed"
    mkdir -p "$HOME/.local/share/zsh/site-functions"
    herdr completion zsh > "$HOME/.local/share/zsh/site-functions/_herdr" 2>/dev/null || true
fi

# ── gondolin: micro-VM backend for `pig` ──────────────────────────────────────
# The extension (source + manifest) is tracked. Only the dependency tree is
# installed here — node_modules and the lockfile stay untracked, same rule as
# .pi/agent/npm. Vendor copy lives OUTSIDE ~/.pi/agent/extensions on purpose:
# pi loads every file in that directory, which would put a VM behind every
# session instead of only behind `pig`.
if [ -f "$HOME/.pi/gondolin-ext/package.json" ]; then
    log "gondolin: installing extension dependencies"
    ( cd "$HOME/.pi/gondolin-ext" && npm install --ignore-scripts --silent ) \
        || warn "gondolin: npm install failed in ~/.pi/gondolin-ext"
fi
# CLI: install into ~/.local so no sudo is needed for a root-owned npm prefix.
# `npm --prefix` does not create the bin link, so create it by hand.
if ! command -v gondolin >/dev/null 2>&1; then
    log "gondolin: installing CLI to ~/.local"
    npm install --prefix "$HOME/.local" --silent @earendil-works/gondolin \
        || warn "gondolin: CLI install failed"
    gbin="$HOME/.local/node_modules/@earendil-works/gondolin/dist/bin/gondolin.js"
    [ -f "$gbin" ] && ln -sf "$gbin" "$HOME/.local/bin/gondolin"
fi

# ── Neovim: parsers + LSP servers + formatters ───────────────────────────────
# lazy.nvim bootstraps itself on first launch; Mason needs a real launch.
if command -v nvim >/dev/null 2>&1; then
    log "neovim: installing plugins, treesitter parsers, and Mason tools"
    nvim --headless "+Lazy! sync" +qa 2>/dev/null || true
    nvim --headless "+TSUpdate" +qa 2>/dev/null || true
    nvim --headless "+MasonToolsInstall" +qa 2>/dev/null || true
    if [ -d "$HOME/.local/share/nvim/parser" ]; then
        log "parsers built: $(find "$HOME/.local/share/nvim/parser" -name '*.so' | wc -l | tr -d ' ')"
    else
        warn "no parsers built — check that 'tree-sitter' is on \$PATH, then :TSUpdate"
    fi
fi

# ── tmux plugins ─────────────────────────────────────────────────────────────
if [ -d "$HOME/.tmux/plugins/tpm" ]; then
    log "tmux: installing plugins"
    "$HOME/.tmux/plugins/tpm/bin/install_plugins" >/dev/null 2>&1 || true
fi

# ── Shell check ──────────────────────────────────────────────────────────────
for f in "$HOME/.zshrc" "$HOME/.config/zsh/common.zsh"; do
    [ -f "$f" ] && zsh -n "$f" || true
done

log "bootstrap complete"
warn "Remaining manual steps:"
cat <<'EOF'
  - GitHub auth:      gh auth login
  - pi provider keys: set in ~/.pi/agent/auth.json (never tracked)
  - macOS only:       yabai/skhd need sudoers + Accessibility permissions
  - Arch only:        autorandr profiles are machine-specific; run autorandr --save <name>
  - herdr:            run `herdr` once to accept onboarding, then `herdr config check`
  - gondolin:         first `pig` boot downloads the guest image (~330MB) to
                      ~/.cache/gondolin — needs network, one-time per machine
  - macOS + gondolin: `brew install qemu` must be done first; Apple Silicon runs
                      arm64 guests, so the alpine-base image is pulled per-arch
EOF
