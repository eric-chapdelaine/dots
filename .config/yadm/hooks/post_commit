#!/usr/bin/env bash
# yadm post_commit hook — regenerate template outputs after a commit.
#
# AGENTS.md is built from .pi/agent/AGENTS.parts/ by `yadm alt`. yadm only runs
# alt on its own CHANGES_POSSIBLE events, and commit is not one of them, so an
# edit to a part would leave the generated file stale until the next pull.
set -uo pipefail

[ "${YADM_HOOK_EXIT:-0}" -eq 0 ] || exit 0

yadm alt >/dev/null 2>&1 || printf '\033[1;33m!!\033[0m yadm alt failed after commit — regenerate by hand\n'
exit 0
