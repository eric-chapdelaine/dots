#!/usr/bin/env bash
# yadm post_pull hook — runs after every `yadm pull`.
#
# Guards the failure mode that bit us once already: a commit that untracks a
# machine-specific file deletes it from the working tree of every clone that
# pulls it. The file is gone, git says nothing, and the next tool launch
# silently recreates a default.
set -uo pipefail

[ "${YADM_HOOK_EXIT:-0}" -eq 0 ] || exit 0

warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }

REPO="${YADM_HOOK_REPO:-$HOME/.local/share/yadm/repo.git}"
WORK="${YADM_HOOK_WORK:-$HOME}"

# Nothing was deleted by this pull → nothing to warn about.
git --git-dir="$REPO" rev-parse -q --verify 'HEAD@{1}' >/dev/null 2>&1 || exit 0
deleted=$(git --git-dir="$REPO" --work-tree="$WORK" \
    diff --diff-filter=D --name-only 'HEAD@{1}' HEAD 2>/dev/null)
[ -n "$deleted" ] || exit 0

# --- 1. Deleted from the index AND still on disk: now silently untracked -----
while IFS= read -r p; do
    [ -n "$p" ] || continue
    if [ -e "$WORK/$p" ]; then
        warn "'$p' was removed from the index but still exists locally — now untracked"
    fi
done <<< "$deleted"

# --- 2. Machine-specific files that the pull may have removed ----------------
# Only checked when a pull deleted something, so a fresh machine with no
# ~/.config/secrets.sh does not produce noise.
state_files=(
    "$HOME/.pi/agent/settings.json"
    "$HOME/.pi/agent/models.json"
    "$HOME/.config/gh/hosts.yml"
)
missing=()
for f in "${state_files[@]}"; do
    [ -e "$f" ] || missing+=("$f")
done

if [ ${#missing[@]} -gt 0 ]; then
    warn "machine-specific files missing after a pull that deleted paths:"
    printf '     %s\n' "${missing[@]}"
    echo "     If the pull untracked one of these, restore it from the previous HEAD:"
    echo "       yadm show 'HEAD@{1}:<path>' > <path>"
    echo "     (gh auth state can usually just be recreated with: gh auth login)"
fi

exit 0
