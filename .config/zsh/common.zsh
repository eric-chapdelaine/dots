# ─────────────────────────────────────────────────────────────
# Shared across Arch Linux and macOS. Sourced by ~/.zshrc.
# ─────────────────────────────────────────────────────────────

# User-local binaries (pi, scripts, etc.)
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# opencode (obsolete — pi coding agent is the current tool)
if [ -d "$HOME/.opencode/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.opencode/bin:"*) ;;
        *) export PATH="$HOME/.opencode/bin:$PATH" ;;
    esac
fi

##################
# Functions
##################

d() {
    docker $1 $(docker ps | fzf --tmux | awk '{print $1}') $2
}

cdt() {
    cd $(fzf --tmux)
}

###############
# Aliases
###############

alias ag='ag -U --path-to-ignore ~/.ignore'
alias t='tmux a -t'
# neovim is the editor on both machines
alias vim='nvim'
alias vi='nvim'

# ── herdr: persistent agent workspaces (replaces the tmux-panes workflow) ──
# h        attach/launch the default herdr session
# hh       launch a new herdr workspace rooted at $PWD
alias h='herdr'
hh() { herdr workspace create --cwd "${1:-$PWD}" --label "$(basename "${1:-$PWD}")"; }

# pig: pi with built-in tools routed into a Gondolin micro-VM.
# Lives at ~/.local/bin/pig (tracked, already on PATH) rather than as an alias,
# so `sh -c pig`, herdr `pane run`, and non-interactive shells all resolve it.

# zsh completions for herdr/pig (generated by ~/.config/yadm/bootstrap; the
# `-d` guard keeps a fresh machine without completion working)
if [[ -d "$HOME/.local/share/zsh/site-functions" ]]; then
    fpath=("$HOME/.local/share/zsh/site-functions" $fpath)
    autoload -Uz compinit && compinit -i
fi
