# ─────────────────────────────────────────────────────────────
# Dotfiles .gitignore
#
# yadm tracks files in $HOME, so this file sees the whole home
# directory. Keep rules anchored and specific — an unanchored
# pattern here can hide unrelated files.
# ─────────────────────────────────────────────────────────────

# --- Secrets: never track ---
.config/gh/hosts.yml
.config/secrets.sh
.pi/agent/auth.json
*.pem
*.key

# --- Machine-specific pi runtime state ---
# settings.json holds default provider/model + installed packages;
# models.json holds local GGUF paths; sessions/ and bin/ are runtime.
.pi/agent/settings.json
.pi/agent/models.json
.pi/agent/models-store.json
.pi/agent/sessions/
.pi/agent/bin/

# --- Package managers ---
# Declarative manifests (package.json) are tracked so the intended
# extension set is versioned; resolved state/lockfiles are not.
.pi/agent/npm/node_modules/
.pi/agent/npm/package-lock.json
.config/opencode/node_modules/
.config/opencode/bun.lock
.config/opencode/package-lock.json
.config/opencode/package.json

# --- Vendored third-party code ---
# Plugin managers fetch these; do not commit them.
.vim/autoload/plug.vim
.vim/autoload/syntaxcomplete.vim
.vim/plugged/
.vim/bundle/
.vim/pack/
.config/nvim/pack/

# --- Generated / nondeterministic state ---
.config/configstore/
Library/Caches/
**/.DS_Store

# --- herdr ---
# config.toml IS tracked. Everything below is server runtime state or is
# regenerated by `herdr integration install pi` / `herdr completion`.
# The pi integration file is managed by herdr and overwritten on every
# integration update, so tracking it produces spurious conflicts.
.config/herdr/*.sock
.config/herdr/*.log
.config/herdr/.plugins.lock
.config/herdr/session.json
.config/herdr/session-history.json
.config/herdr/session-snapshots/
.config/herdr/session-backups/
.config/herdr/plugins/
.config/herdr/agent-detection/
.pi/agent/extensions/herdr-agent-state.ts
.local/share/zsh/site-functions/_herdr

# --- gondolin ---
# The extension manifest + source are tracked; the resolved dependency tree
# and lockfile are not (same rule as .pi/agent/npm).
.pi/gondolin-ext/node_modules/
.pi/gondolin-ext/package-lock.json

# --- Work-only skills (kept on disk, not published) ---
.config/opencode/skills/create-pr/SKILL.md
.config/opencode/skills/run-repos-locally/SKILL.md
.config/opencode/skills/workflow-storybook-testing/SKILL.md

# --- Work repos (Nile) ---
.Nile-Core/
.NileWebApps/
/opt/nile-core
/opt/nile-webapps
/agent/repos/Nile-Core/
/agent/repos/NileWebApps/

# --- Neomutt: local mail credentials ---
.config/neomutt/secrets

# --- rmview (reMarkable): SSH root password in cleartext ---
.config/rmview.json
.config/rmview_known_hosts
