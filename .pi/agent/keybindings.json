{
  "$schema": "https://pi.dev/schemas/keybindings.schema.json",

  "tui.altScreen.lineUp": ["alt+k"],
  "tui.altScreen.lineDown": ["alt+j"],

  "tui.altScreen.halfPageUp": ["ctrl+alt+k", "alt+u"],
  "tui.altScreen.halfPageDown": ["ctrl+alt+j", "alt+n"],

  "tui.altScreen.previousPrompt": ["alt+[", "ctrl+shift+up"],
  "tui.altScreen.nextPrompt": ["alt+]", "ctrl+shift+down"],

  "tui.altScreen.top": ["alt+g"],
  "tui.altScreen.bottom": ["ctrl+alt+g"],

  "tui.altScreen.search": ["alt+/", "ctrl+shift+f"],

  "app.interrupt": ["alt+x", "ctrl+alt+x", "escape"]
}
